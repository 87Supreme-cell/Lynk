# Local Docker PostgreSQL/pgvector development database.
POSTGRES_DB=lynk
POSTGRES_USER=lynk
POSTGRES_PASSWORD=change-me-for-local-development
LYNK_DATABASE_URL=postgresql://lynk:change-me-for-local-development@localhost:5433/lynk

# Local model connection. Choose `ollama` or `open_webui`; do not commit keys.
LYNK_MODEL_PROVIDER=ollama
LYNK_MODEL_BASE_URL=http://localhost:11434
LYNK_MODEL_NAME=replace-with-your-gemma-or-qwen-model-id
LYNK_MODEL_TEMPERATURE=0.1
LYNK_MODEL_TOP_P=0.85
# LYNK_MODEL_API_KEY=optional-local-key
